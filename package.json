{
    "name": "coder-online-tools",
    "version": "0.1.0",
    "author": "lidong",
    "description": "Vue + Tailwind + Vite based online tools for chart plotting and J1939 conversion.",
    "homepage": "https://linde-md.github.io/coder-online-tools/",
    "repository": {
        "type": "git",
        "url": "https://github.com/Linde-MD/coder-online-tools.git"
    },
    "keywords": [
        "node.js",
        "vite",
        "koa",
        "CAN",
        "J1939"
    ],
    "dependencies": {
        "bootstrap": "^5.3.8",
        "d3": "^7.9.0",
        "koa": "^3.0.0",
        "koa-proxies": "^0.12.4",
        "koa-static": "^5.0.0",
        "lodash": "^4.17.21",
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "autoprefixer": "^10.5.4",
        "pkg": "^5.8.1",
        "postcss": "^8.5.25",
        "tailwindcss": "^4.3.3",
        "vite": "^7.1.0"
    },
    "scripts": {
        "dev": "vite",
        "build:web": "vite build",
        "preview": "vite preview",
        "serve:koa": "node scripts/server/koa-server.js",
        "build:exe": "npm run build:web && pkg scripts/server/koa-server.js --targets node18-win-x64 --output dist/coder-online-tools-lab.exe",
        "j1939:id-to-pgn": "node scripts/j1939/id-to-pgn.js",
        "j1939:pgn-to-id": "node scripts/j1939/pgn-to-id.js"
    },
    "pkg": {
        "assets": [
            "dist/web/**/*"
        ]
    }
}
